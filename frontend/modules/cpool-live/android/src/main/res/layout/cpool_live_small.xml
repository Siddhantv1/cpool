<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed live card (approved demo, cpool-guest-card.html): title and text only, one line each, demo colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/cpool_live_bg_small"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="8dp"
  android:paddingEnd="12dp"
  android:paddingBottom="8dp">

  <TextView
    android:id="@+id/cpool_live_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:maxLines="1"
    android:textColor="#0B1020"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/cpool_live_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#3D4456"
    android:textSize="12sp" />
</LinearLayout>
