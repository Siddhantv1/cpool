<?xml version="1.0" encoding="utf-8"?>
<!-- Host island, opened (approved demo, cpool-host-island.html): the full-size demo host card floating over other
     apps, plus Picked up at a pickup. A normal view (not a notification), so it can be touched and updated freely. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/cpool_island_bg"
  android:elevation="10dp"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingTop="14dp"
  android:paddingEnd="14dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:importantForAccessibility="no"
      android:src="@drawable/cpool_live_c" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:fontFamily="sans-serif-medium"
      android:text="Cpool"
      android:textColor="#2A3142"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/cpool_live_sub"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#5E6577"
      android:textSize="12sp" />

    <ImageView
      android:id="@+id/cpool_island_close"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:contentDescription="Shrink"
      android:rotation="180"
      android:src="@drawable/cpool_live_chevron" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/cpool_island_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/cpool_live_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#0B1020"
        android:textSize="15.5sp" />

      <TextView
        android:id="@+id/cpool_live_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#3D4456"
        android:textSize="13.5sp" />
    </LinearLayout>

    <ImageView
      android:id="@+id/cpool_live_tile"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="12dp"
      android:importantForAccessibility="no" />
  </LinearLayout>

  <ImageView
    android:id="@+id/cpool_live_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:adjustViewBounds="true"
    android:importantForAccessibility="no"
    android:scaleType="fitCenter" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/cpool_island_picked"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:background="@drawable/cpool_live_pill_green"
      android:fontFamily="sans-serif-medium"
      android:paddingStart="14dp"
      android:paddingTop="8dp"
      android:paddingEnd="14dp"
      android:paddingBottom="8dp"
      android:text="Picked up"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/cpool_live_call"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/cpool_live_pill"
      android:drawablePadding="6dp"
      android:fontFamily="sans-serif-medium"
      android:gravity="center_vertical"
      android:paddingStart="14dp"
      android:paddingTop="8dp"
      android:paddingEnd="14dp"
      android:paddingBottom="8dp"
      android:text="Call"
      android:textColor="#1A2B6B"
      android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
