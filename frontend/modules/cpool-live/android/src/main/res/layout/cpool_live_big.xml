<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded live card, compact (approved demo, cpool-guest-card.html): header, title + text, tile, bar, buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/cpool_live_bg"
  android:orientation="vertical"
  android:paddingStart="11dp"
  android:paddingTop="9dp"
  android:paddingEnd="11dp"
  android:paddingBottom="9dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:importantForAccessibility="no"
      android:src="@drawable/cpool_live_c" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="5dp"
      android:fontFamily="sans-serif-medium"
      android:text="Cpool"
      android:textColor="#2A3142"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/cpool_live_sub"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#5E6577"
      android:textSize="11sp" />

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:importantForAccessibility="no"
      android:src="@drawable/cpool_live_chevron" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/cpool_live_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#0B1020"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/cpool_live_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#3D4456"
        android:textSize="12sp" />
    </LinearLayout>

    <ImageView
      android:id="@+id/cpool_live_tile"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_marginStart="10dp"
      android:importantForAccessibility="no" />
  </LinearLayout>

  <ImageView
    android:id="@+id/cpool_live_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:adjustViewBounds="true"
    android:importantForAccessibility="no"
    android:scaleType="fitCenter" />

  <LinearLayout
    android:id="@+id/cpool_live_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/cpool_live_call"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/cpool_live_pill"
      android:drawableStart="@drawable/cpool_live_phone"
      android:drawablePadding="5dp"
      android:fontFamily="sans-serif-medium"
      android:gravity="center_vertical"
      android:paddingStart="12dp"
      android:paddingTop="6dp"
      android:paddingEnd="12dp"
      android:paddingBottom="6dp"
      android:text="Call"
      android:textColor="#1A2B6B"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/cpool_live_share"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:background="@drawable/cpool_live_pill"
      android:drawableStart="@drawable/cpool_live_share"
      android:drawablePadding="5dp"
      android:fontFamily="sans-serif-medium"
      android:gravity="center_vertical"
      android:paddingStart="12dp"
      android:paddingTop="6dp"
      android:paddingEnd="12dp"
      android:paddingBottom="6dp"
      android:text="Share trip"
      android:textColor="#1A2B6B"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
