<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 16 Live Updates: lets the ride card be pinned with a chip in the status bar. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!-- Host island: Cpool's pill over other apps while driving (the host turns it on once in Android settings). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Ride service while the host drives: keeps the island and the ride card updating with Cpool in the background. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

  <application>
    <service
      android:name="expo.modules.cpoollive.CpoolRideService"
      android:exported="false"
      android:foregroundServiceType="location" />
    <!-- Picked up / Complete ride on Android's Live Update card. -->
    <receiver
      android:name="expo.modules.cpoollive.CpoolActionReceiver"
      android:exported="false" />
  </application>
</manifest>
