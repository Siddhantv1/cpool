{
  "expo": {
    "name": "Cpool",
    "slug": "cpool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cpool",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aswin.cpool.dev"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CCE5D2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.cpool",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DDEED8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cpool needs your photos so you can choose a picture of your RC.",
          "cameraPermission": "Cpool needs the camera so you can take a picture of your RC.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cpool uses your location to show rides near you and your pickup point.",
          "locationAlwaysAndWhenInUsePermission": "Cpool uses your location during a hosted ride for navigation and live ride updates.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "@bacons/apple-targets",
      "@rnmapbox/maps",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0E6464",
          "enableRemoteNotifications": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
